# Copy to .env for local development. Never put real keys here; use AWS Secrets Manager outside dev.
COUNSEL_ENV=dev
COUNSEL_DATABASE_URL=postgresql://counsel:counsel_dev@localhost:5433/counsel
COUNSEL_TEST_ADMIN_URL=postgresql://counsel:counsel_dev@localhost:5433/counsel
COUNSEL_AWS_REGION=ap-south-1
# Fill after checking the Bedrock India endpoint (see infra/README.md)
COUNSEL_MODEL_TRIAGE=
COUNSEL_MODEL_DRAFTING=
COUNSEL_MODEL_VERIFIER=
